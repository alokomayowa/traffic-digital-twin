<?xml version="1.0" encoding="UTF-8"?>
<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="network/osm.net.xml"/>
        <route-files value="demand/toronto_val.rou.xml"/>
        <additional-files value="detectors/detectors.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="86400"/>
    </time>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>

</sumoConfiguration>